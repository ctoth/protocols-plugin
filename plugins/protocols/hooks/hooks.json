{
  "description": "Register actor-scoped protocol Ward rules and initialize Task roles",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/ward-register.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/ward-role.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
